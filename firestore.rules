rules_version = '2';
// Datos de AHHHHHH Today
//  - users/{uid}: a qué plan pertenece cada persona (solo lo ve y lo cambia ella misma)
//  - plans/{planId}: dueño y correos que comparten el plan
//  - plans/{planId}/kv/{clave}: los datos del plan (actividades, eventos, ajustes…)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /plans/{planId} {
      function isMember(d) { return myEmail() in d.memberEmails; }
      // Ver el plan (y buscar invitaciones): solo quien está en la lista
      allow read: if signedIn() && isMember(resource.data);
      // Crear: uno mismo como dueño y en la lista
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.memberEmails is list
        && myEmail() in request.resource.data.memberEmails
        && request.resource.data.memberEmails.size() <= 20;
      // Cambiar la lista: solo el dueño, sin cambiar de dueño ni quitarse a sí mismo
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.memberEmails is list
        && resource.data.ownerEmail in request.resource.data.memberEmails
        && request.resource.data.memberEmails.size() <= 20;
      allow delete: if false;

      match /kv/{key} {
        function member() {
          return signedIn() && myEmail() in get(/databases/$(database)/documents/plans/$(planId)).data.memberEmails;
        }
        allow read: if member();
        allow write: if member()
          && request.resource.data.keys().hasOnly(['v', 'at', 'by'])
          && (request.resource.data.v == null || (request.resource.data.v is string && request.resource.data.v.size() < 500000))
          && request.resource.data.by == request.auth.uid;
        allow delete: if member();
      }
    }
  }
}
